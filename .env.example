# Copy this file to .env and fill in real values. NEVER commit .env.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/repopilot
# Optional: where ChromaDB stores vectors (default: <project>/chroma_store)
# CHROMA_DB_PATH=chroma_store
# Optional, development only: use a throwaway local SQLite file when POSTGRES_URL is unset
# REPOPILOT_ALLOW_SQLITE=1
# Optional: load a different env file than <project>/.env
# REPOPILOT_ENV_FILE=C:\path\to\other.env
# /ask LLM. Primary provider (default gemini). Keys live ONLY in your local .env, never in git.
GEMINI_API_KEY=YOUR_GEMINI_KEY
# LLM_PROVIDER=gemini                     # gemini | openrouter
# LLM_MODEL=gemini-2.5-flash              # model of the primary provider
# Optional automatic fallback, used when the primary fails after its retries (or is misconfigured):
# LLM_FALLBACK_PROVIDER=openrouter
# LLM_FALLBACK_MODEL=google/gemini-2.5-flash
# OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY
# Retries (HTTP 429/503 and timeouts only; exponential backoff 1s,2s,4s... capped):
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_SECONDS=1.0
# LLM_RETRY_MAX_SECONDS=8.0
# LLM_TOTAL_TIMEOUT_SECONDS=120
# ASK_MIN_SCORE=0.20
# LLM_TIMEOUT_SECONDS=45
